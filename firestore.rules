rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the caller is the owner of the user document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is a member of the trip
    function isTripMember(tripId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)) ||
        (resource != null && (resource.data.adminId == request.auth.uid || resource.data.coAdminId == request.auth.uid))
      );
    }

    // Helper function to check if user is the admin of the trip
    function isTripAdmin(tripId) {
      return isAuthenticated() && (
        (resource != null && resource.data.adminId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Helper function to check if user is admin or co-admin (authorized editor)
    function isTripEditor(tripId) {
      return isAuthenticated() && (
        (resource != null && (resource.data.adminId == request.auth.uid || resource.data.coAdminId == request.auth.uid)) ||
        (exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role == 'co-admin'))
      );
    }

    // Users collection: readable by authenticated users for member display name lookup
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Trips collection:
    // - Only authenticated members/admin/co-admin can read trip details
    // - Authenticated users can list trips (required for looking up trip by join code)
    // - Admin and co-admin can update
    // - Admin ONLY can delete
    match /trips/{tripId} {
      allow get: if isTripMember(tripId);
      allow list: if isAuthenticated();

      allow create: if isAuthenticated() &&
                    request.resource.data.adminId == request.auth.uid &&
                    request.resource.data.coAdminId == null &&
                    request.resource.data.status == 'Planning' &&
                    request.resource.data.id == tripId;

      allow update: if isTripEditor(tripId);
      allow delete: if isTripAdmin(tripId);

      // Members subcollection: trips/{tripId}/members/{memberUid}
      match /members/{memberUid} {
        allow get: if isAuthenticated() && (request.auth.uid == memberUid || isTripMember(tripId));
        allow list: if isAuthenticated() && isTripMember(tripId);

        allow create: if isAuthenticated() && (
          (request.auth.uid == memberUid && request.resource.data.uid == request.auth.uid &&
           (request.resource.data.role == 'member' || request.resource.data.role == 'admin')) ||
          isTripAdmin(tripId)
        );

        allow update: if isTripAdmin(tripId);
        allow delete: if isTripAdmin(tripId) || (isAuthenticated() && request.auth.uid == memberUid && resource.data.role != 'admin');
      }
    }

    // Collection group rule: allows users to query their own memberships across all trips
    match /{path=**}/members/{memberUid} {
      allow read: if isAuthenticated() && (request.auth.uid == memberUid || resource.data.uid == request.auth.uid);
    }
  }
}
